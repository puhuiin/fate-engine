# fate-engine server 环境变量示例
# 复制为 .env 后按需修改（或直接注入环境变量）

# 签名密钥：token 与响应签名（sign 字段）均依赖此密钥。
# 生产环境必填，未设置将拒绝启动；本地开发缺省使用内置开发密钥。
FATE_SECRET=

# 监听地址与端口
HOST=0.0.0.0
PORT=3001

# 运行环境：development | production
NODE_ENV=development

# CORS 允许来源白名单（逗号分隔）。生产建议显式配置，如 https://a.com,https://b.com
# 未设置时允许全部来源（仅建议本地开发）。
CORS_ORIGIN=

# 全局接口速率限制：每 IP 每分钟最大请求数（默认 300，认证/注册接口 20）
# 进程内滑动窗口，仅单实例部署有效。
RATE_LIMIT_MAX=300

# 是否信任反向代理的 X-Forwarded-For 头（true / 信任跳数 1/2/...）。
# 部署在 nginx 等代理之后时建议开启，否则限流会按代理地址统一分桶。
TRUST_PROXY=true
